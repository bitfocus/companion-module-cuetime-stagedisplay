{
	"name": "cuetime-stagedisplay",
	"version": "0.1.0",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"format": "prettier -w .",
		"generate-icons": "node scripts/generate-icons.mjs",
		"generate-protocol": "node scripts/generate-protocol.mjs && prettier -w src/protocol/generated.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"clean": "node scripts/clean.mjs",
		"build": "node scripts/generate-icons.mjs && yarn generate-protocol && tsc --noEmit && node scripts/clean.mjs && tsc -p tsconfig.build.json",
		"package": "node scripts/generate-icons.mjs && yarn generate-protocol && tsc --noEmit && node scripts/clean.mjs && tsc -p tsconfig.build.json && companion-module-build",
		"test": "vitest run"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-cuetime-stagedisplay.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-cuetime-stagedisplay/issues"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^25.9.3",
		"@types/ws": "^8.18.2",
		"ajv": "^8.20.0",
		"eslint": "^10.2.0",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.12"
	},
	"resolutions": {
		"colord": "^2.10.0",
		"esbuild": "^0.28.1",
		"fast-uri": "^3.1.9",
		"postcss": "^8.5.23",
		"source-map-js": "^1.2.2",
		"tar": "^7.5.22",
		"undici": "^6.29.1",
		"vite": "^8.3.5"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.12.0"
}
