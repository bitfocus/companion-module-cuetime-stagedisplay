{
	"name": "cuetime-stagedisplay",
	"version": "0.1.0",
	"type": "module",
	"main": "dist/main.js",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"generate-icons": "node scripts/generate-icons.mjs",
		"generate-protocol": "node scripts/generate-protocol.mjs && prettier -w src/protocol/generated.ts",
		"typecheck": "tsc --noEmit",
		"build": "node scripts/generate-icons.mjs && yarn generate-protocol && tsc --noEmit && rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"package": "run build && companion-module-build",
		"lint:raw": "eslint",
		"lint": "run lint:raw .",
		"test": "vitest run"
	},
	"license": "MIT",
	"author": "Joshua D. Boyd for CueTime.io <jdboyd@boydtechnicalsolutions.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-cuetime-stagedisplay.git"
	},
	"bugs": {
		"url": "https://github.com/bitfocus/companion-module-cuetime-stagedisplay/issues"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"ws": "^8.22.0"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26.6.4",
		"@types/ws": "^8.18.2",
		"ajv": "^8.20.0",
		"eslint": "^10.2.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.8.3",
		"rimraf": "^6.1.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^4.1.12"
	},
	"resolutions": {
		"colord": "^2.10.0",
		"esbuild": "^0.28.1",
		"fast-uri": "^3.1.9",
		"postcss": "^8.5.23",
		"source-map-js": "^1.2.2",
		"tar": "^7.5.22",
		"undici": "^6.29.1",
		"vite": "^8.3.5"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.12.0",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"yarn lint:raw --fix"
		],
		"{schemas/protocol-schema.json,scripts/generate-protocol.mjs}": [
			"sh -c 'yarn generate-protocol && git add src/protocol/generated.ts'"
		]
	}
}
